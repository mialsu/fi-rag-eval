# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Groq API key. A PAID Developer plan is approved for this project (ADR-0008),
# capped at $25/month at the provider. Per-run cost is NOT yet measured: ADR-0008's
# ~$0.067 estimate assumed non-reasoning models and is known to be low. The real
# figure comes from `completion_cost()` once the answer phase runs.
GROQ_API_KEY=

# Master key for the local LiteLLM Proxy in compose.yaml. Any random string;
# it authenticates this machine to its own gateway, not to Groq.
LITELLM_MASTER_KEY=
